{
  "name": "event-modeling-spec-cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "ModelingProject Event Modeling CLI - file-based YAML architecture",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "default": "./dist/domain/*.js"
    },
    "./graph/*": {
      "types": "./dist/graph/*.d.ts",
      "default": "./dist/graph/*.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*.d.ts",
      "default": "./dist/layout/*.js"
    },
    "./viewer-contract": {
      "types": "./dist/viewer-contract/index.d.ts",
      "default": "./dist/viewer-contract/index.js"
    },
    "./viewer-contract/*": {
      "types": "./dist/viewer-contract/*.d.ts",
      "default": "./dist/viewer-contract/*.js"
    }
  },
  "bin": {
    "em": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-develop/EventModelingCLI.git"
  },
  "bugs": {
    "url": "https://github.com/victor-develop/EventModelingCLI/issues"
  },
  "homepage": "https://github.com/victor-develop/EventModelingCLI#readme",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  }
}
